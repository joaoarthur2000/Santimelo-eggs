// Banco do EGGS by Santimelo: app de pedidos de ovos + painel da equipe.
// Local: SQLite (prisma/dev.db). ProduÃ§Ã£o: trocar provider para "postgresql" e DATABASE_URL.
// Campos "tipo/status/papel" sÃ£o String com valores definidos em src/lib/constantes.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  papel        String // DIRETOR | CLIENTE
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  clienteId    String?   @unique // papel CLIENTE: o cliente do app que esse login representa
  codigoAcesso String?   @unique // o cliente entra com cÃ³digo (ex: EGG-7K3P) + senha
  falhas       Int       @default(0) // senhas erradas seguidas; 5 bloqueia por 15 min
  bloqueadoAte DateTime?
  ultimoAcesso DateTime?
  cliente      Cliente?  @relation(fields: [clienteId], references: [id])
}

// Tipo de ovo (ex: Ovo branco). O estoque Ã© contado em caixas de 360 ovos.
model Item {
  id             String             @id @default(cuid())
  codigo         String?            @unique // "1", "2"... fixo: nÃ£o muda quando entra tipo novo
  nome           String             @unique
  unidadeEstoque String             @default("caixa")
  ativo          Boolean            @default(true)
  ordem          Int                @default(0)
  produtos       Produto[]
  movimentos     MovimentoEstoque[]
}

// O que o cliente compra. Ex: Ovo branco Â· Caixa (12 bandejas de 30)
model Produto {
  id              String           @id @default(cuid())
  codigo          String?          @unique
  itemId          String
  item            Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  embalagem       String // "Caixa (12 bandejas de 30)", "Bandeja 30 un"...
  unidade         String // caixa | bandeja
  fatorEstoque    Float? // quanto do estoque do item 1 unidade vendida consome (bandeja 30 ovos = 1/12 caixa); nulo = nÃ£o controla
  preco           Float
  ativo           Boolean          @default(true)
  pedidoItens     PedidoItem[]
  precos          HistoricoPreco[]
  precosCliente   PrecoCliente[]
  precosAgendados PrecoAgendado[]
}

// Cada preÃ§o de venda que o produto jÃ¡ teve (base do grÃ¡fico de custo Ã— venda)
model HistoricoPreco {
  id        String   @id @default(cuid())
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  preco     Float
  em        DateTime @default(now())
  origem    String // INICIAL | PAINEL | AGENDADO
  autor     String?

  @@index([produtoId, em])
}

// Cliente do app (padaria, confeitaria, restaurante...). A Santimelo cadastra; nÃ£o existe cadastro aberto
model Cliente {
  id                 String         @id @default(cuid())
  razaoSocial        String
  nomeFantasia       String
  cnpj               String?
  tipoNegocio        String
  endereco           String? // rua e nÃºmero
  bairro             String?
  cidade             String?        @default("Porto Alegre")
  cep                String?
  lat                Float? // posiÃ§Ã£o do endereÃ§o (pra rota do dia), achada pelo endereÃ§o
  lng                Float?
  linkMaps           String? // link do Google Maps / Meu Negócio colado no cadastro
  responsavel        String?
  email              String?
  whatsapp           String?
  formaPagamento     String? // Pix, Dinheiro, Boleto, CartÃ£o, TransferÃªncia
  notaFiscal         Boolean        @default(false) // vende com NF?
  observacoes        String?
  ativo              Boolean        @default(true)
  criadoEm           DateTime       @default(now())
  consumoSemanal     Float? // caixas de ovos por semana (estimativa combinada)
  limiteCredito      Float? // quanto pode ficar em aberto, em R$
  prazoPagamentoDias Int? // dias depois da entrega pra pagar
  negociacao         String? // o que foi combinado, aparece pro cliente no app
  valorVenda         Float? // preÃ§o combinado da caixa de ovo branco (vira o preÃ§o especial dele)
  valorCusto         Float? // custo da caixa considerado pra esse cliente (margem na ficha)
  regiaoId           String?
  regiao             Regiao?        @relation(fields: [regiaoId], references: [id])
  usuario            Usuario?
  pedidos            Pedido[]
  precosEspeciais    PrecoCliente[]
  cobrancas          Cobranca[]
  mensagens          Mensagem[]
  atendimentos       Atendimento[]
}

// RegiÃ£o de entrega (ex: Zona Norte) com os dias e horÃ¡rios em que o caminhÃ£o passa
model Regiao {
  id       String          @id @default(cuid())
  nome     String          @unique
  bairros  String?
  ativo    Boolean         @default(true)
  janelas  JanelaEntrega[]
  clientes Cliente[]
}

// HorÃ¡rio de entrega numa regiÃ£o: dia da semana (0 = domingo) + faixa + quantos pedidos cabem
model JanelaEntrega {
  id         String   @id @default(cuid())
  regiaoId   String
  regiao     Regiao   @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  diaSemana  Int
  inicio     String // "07:00"
  fim        String // "09:00"
  capacidade Int      @default(6)
  ativo      Boolean  @default(true)
  pedidos    Pedido[]

  @@unique([regiaoId, diaSemana, inicio])
}

// PreÃ§o negociado com um cliente (vale no lugar do preÃ§o de tabela)
model PrecoCliente {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  preco     Float

  @@unique([clienteId, produtoId])
}

// PreÃ§o futuro jÃ¡ decidido: o cliente vÃª no app com antecedÃªncia (previsibilidade) e ele entra sozinho no dia
model PrecoAgendado {
  id         String    @id @default(cuid())
  produtoId  String
  produto    Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  preco      Float
  aPartirDe  String // "AAAA-MM-DD"
  aplicadoEm DateTime?
  autor      String
  criadoEm   DateTime  @default(now())

  @@index([aPartirDe])
}

// Conta a receber de um pedido: vence N dias depois da entrega (prazo combinado com o cliente)
model Cobranca {
  id         String    @id @default(cuid())
  clienteId  String
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  pedidoId   Int?      @unique
  pedido     Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  valor      Float
  vencimento String // "AAAA-MM-DD"
  descricao  String? // cobranÃ§a sem pedido (ex: saldo em aberto de antes do sistema)
  pagoEm     DateTime?
  criadoEm   DateTime  @default(now())

  @@index([vencimento])
}

// Mensagem que aparece no app do cliente. chave evita repetir o mesmo aviso automÃ¡tico
model Mensagem {
  id        String    @id @default(cuid())
  clienteId String
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo      String // PAGAMENTO | PEDIDO | AVISO | STATUS (pedido mudou de etapa: o app avisa com som e vibraÃ§Ã£o)
  texto     String
  chave     String?   @unique
  autor     String
  criadaEm  DateTime  @default(now())
  lidaEm    DateTime?

  @@index([clienteId, criadaEm])
}

model Pedido {
  id          Int                @id @default(autoincrement())
  clienteId   String
  cliente     Cliente            @relation(fields: [clienteId], references: [id])
  status      String             @default("NOVO") // NOVO | SEPARACAO | ENTREGA | ENTREGUE | CANCELADO
  origem      String             @default("APP") // APP | PAINEL | WHATSAPP
  dataEntrega DateTime
  observacao  String?
  total       Float              @default(0)
  notaFiscal  Boolean            @default(false) // com NF: copiado do cliente quando o pedido Ã© criado
  criadoEm    DateTime           @default(now())
  janelaId    String? // horÃ¡rio de entrega escolhido no app
  janela      JanelaEntrega?     @relation(fields: [janelaId], references: [id])
  itens       PedidoItem[]
  movimentos  MovimentoEstoque[]
  cobranca    Cobranca?
  atendimentos Atendimento[]

  @@index([dataEntrega])
}

model PedidoItem {
  id         String  @id @default(cuid())
  pedidoId   Int
  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto @relation(fields: [produtoId], references: [id])
  quantidade Float
  precoUnit  Float
  subtotal   Float
  fornecedorId String? // de qual fornecedor saíram essas caixas: baixa o estoque dele e dá o rastreio fornecedor → cliente
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])
}

// Extrato do estoque, em caixas. tipo: COMPRA (+) | VENDA (âˆ’, pedido saiu pra entrega) | PERDA (âˆ’) | AJUSTE (Â±, contagem)
// quantidade Ã© sempre com sinal: entrada positiva, saÃ­da negativa
model MovimentoEstoque {
  id         String   @id @default(cuid())
  data       DateTime @default(now())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  tipo       String
  quantidade Float
  custoUnit  Float? // sÃ³ na compra: R$ por caixa
  origem     String? // na compra (lanÃ§amentos antigos): GRANJA | CEASA | FORNECEDOR
  fornecedor String? // nome livre (lanÃ§amentos antigos); os novos usam fornecedorId
  marca      String? // marca dos ovos comprados (ex: Granja X), lançada em Fornecedores
  fornecedorId String?
  fornecedorCad Fornecedor? @relation(fields: [fornecedorId], references: [id])
  pedidoId   Int?
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  observacao String?
  autor      String

  @@index([data])
  @@index([itemId, data])
}

// De quem a Santimelo compra (ex: RogÃ©rio Ovos, Fabiano CEASA, Suprema Hortifruti)
model Fornecedor {
  id         String             @id @default(cuid())
  nome       String             @unique
  contato    String? // telefone ou WhatsApp
  produtos   String? // o que costuma vender pra Santimelo (texto livre)
  ativo      Boolean            @default(true)
  ordem      Int                @default(0)
  criadoEm   DateTime           @default(now())
  compras    MovimentoEstoque[]
  itensVendidos PedidoItem[]
  pagamentos PagamentoFornecedor[]
}

// Pagamento feito a um fornecedor: abate do que a Santimelo deve pelas compras (A pagar = comprado − pago)
model PagamentoFornecedor {
  id           String     @id @default(cuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  dia          String // "AAAA-MM-DD"
  valor        Float
  forma        String? // "Pix" | "Dinheiro" (pagamentos lançados antes de 18/11 ficam sem)
  observacao   String?
  autor        String
  criadoEm     DateTime   @default(now())

  @@index([fornecedorId])
}

// Gasto da operaÃ§Ã£o que nÃ£o Ã© compra de mercadoria (embalagem, manutenÃ§Ã£o, pessoal...). CombustÃ­vel vem das rotas.
model Despesa {
  id             String   @id @default(cuid())
  dia            String // "AAAA-MM-DD"
  descricao      String
  categoria      String // ver CATEGORIAS_DESPESA em src/lib/constantes.ts
  valor          Float
  formaPagamento String?
  autor          String
  criadoEm       DateTime @default(now())

  @@index([dia])
}

// VeÃ­culo da entrega. Custos fixos anuais sÃ£o rateados por dia; manutenÃ§Ã£o e pneus, por km rodado.
model Veiculo {
  id                 String         @id @default(cuid())
  apelido            String // ex: "Fiorino"
  modelo             String // ex: "Fiat Fiorino Hard Working 1.4 8V"
  ano                Int
  placa              String         @unique
  combustivel        String         @default("Gasolina")
  consumoKmL         Float // km por litro na cidade
  precoLitro         Float
  kmAtual            Int?
  ipvaAnual          Float          @default(0)
  seguroAnual        Float          @default(0)
  licenciamentoAnual Float          @default(0)
  outrosFixosAnual   Float          @default(0) // rastreador, estacionamento mensal Ã— 12...
  manutencaoPorKm    Float          @default(0) // revisÃµes, Ã³leo, freio, suspensÃ£o
  pneusPorKm         Float          @default(0)
  ativo              Boolean        @default(true)
  criadoEm           DateTime       @default(now())
  gastos             GastoVeiculo[]
}

// Gasto real com o veÃ­culo: abastecimento, manutenÃ§Ã£o, pneus, IPVA, seguro, multa...
model GastoVeiculo {
  id        String   @id @default(cuid())
  veiculoId String
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  dia       String // "AAAA-MM-DD"
  tipo      String // ver TIPOS_GASTO_VEICULO em src/lib/constantes.ts
  descricao String?
  valor     Float
  litros    Float? // abastecimento
  km        Int? // hodÃ´metro na hora
  autor     String
  criadoEm  DateTime @default(now())

  @@index([veiculoId, dia])
}

// ConfiguraÃ§Ãµes do sistema (chave â†’ valor). Ex: modo manutenÃ§Ã£o do app
model Configuracao {
  chave    String   @id
  valor    String
  alterado DateTime @updatedAt
}

// Chat do Guinho no app: o cliente escolhe o assunto e, se quiser falar com gente, vira atendimento no painel
model Atendimento {
  id          Int       @id @default(autoincrement()) // nÃºmero do protocolo
  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  setor       String // VENDAS | ENTREGA | FINANCEIRO | TECNICO
  motivo      String // o que ele escolheu (ex: "Veio ovo quebrado")
  detalhe     String? // o que ele escreveu
  pedidoId    Int?
  pedido      Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  contato     String // WHATSAPP (ele chamou no WhatsApp) | RETORNO (a equipe chama ele) | CHAT (conversa no app)
  status      String    @default("ABERTO") // ABERTO | ANDAMENTO | RESOLVIDO
  nota        String? // anotaÃ§Ã£o da equipe
  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?
  conversa    MensagemAtendimento[]

  @@index([status, criadoEm])
}

// Conversa do atendimento: equipe (painel) â†” cliente (app)
model MensagemAtendimento {
  id            Int         @id @default(autoincrement())
  atendimentoId Int
  atendimento   Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  de            String // CLIENTE | EQUIPE
  autor         String
  texto         String
  criadaEm      DateTime    @default(now())
  lidaEm        DateTime? // lida pelo outro lado

  @@index([atendimentoId, criadaEm])
}

// Rota de entregas do dia: km pela rota calculada, km real (hodÃ´metro) e combustÃ­vel
model RotaDia {
  dia          String   @id // "AAAA-MM-DD"
  ordem        String // ids dos pedidos na ordem da rota, separados por vÃ­rgula
  kmPlanejado  Float
  minutos      Float
  kmReal       Float? // o que o motorista anotou no hodÃ´metro
  consumoKmL   Float // km por litro usado na conta
  precoLitro   Float
  atualizadoEm DateTime @updatedAt
}

// Prospecção (aba Prospecção do painel): estabelecimentos que ainda não são clientes. Vêm da busca no Google
// (Places API, por tipo e região) ou do bot de prospecção (../prospeccao-bot). Status: STATUS_LEAD em src/lib/prospeccao.ts
model Lead {
  id            String    @id @default(cuid())
  nome          String
  tipoNegocio   String // TIPOS_NEGOCIO
  telefone      String? // como aparece: "(51) 99999-9999"
  whatsapp      String? // só os dígitos com DDD, sem o 55: vira o link do WhatsApp
  celular       Boolean   @default(false) // celular quase sempre tem WhatsApp; fixo pode ter WhatsApp Business
  endereco      String? // rua e número
  bairro        String?
  cidade        String?
  cep           String?
  regiao        String? // região pedida na busca ("Zona Sul")
  lat           Float?
  lng           Float?
  linkMaps      String?
  googlePlaceId String?   @unique
  nota          Float? // nota no Google
  avaliacoes    Int? // quantas avaliações no Google
  site          String?
  cnpj          String? // só os dígitos
  razaoSocial   String?
  porte         String? // MEI, ME, EPP ou Demais (Receita Federal)
  situacaoCnpj  String? // Ativa, Baixada... (Receita Federal)
  status        String    @default("NOVO")
  lote          String? // de qual busca veio: "10/11 · Lancheria · Zona Sul"
  observacoes   String?
  contatadoEm   DateTime? // quando a primeira mensagem saiu
  proximoPasso  String? // "AAAA-MM-DD": dia de voltar a falar
  clienteId     String? // virou cliente: id do Cliente
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  @@index([status])
  @@index([whatsapp])
}
